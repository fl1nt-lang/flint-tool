// sha256 - SHA-256 (FIPS 180-4), for checking what was downloaded against the hash in flint.toml.

import base.alloc;

let K = [_]u32 {
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
};

// The arithmetic is done in u64 and masked, so no step depends on how u32 shifts drop bits.
let M: u64 = 0xffffffff;

fn rotr(x: u64, n: u64) -> u64 { return ((x >> n) | (x << (32 - n))) & M; }

fn block(h: *[8]u64, b: []const u8) {
    var w: [64]u64 = undefined;
    for (0..16) |i| {
        let a: u64 = b[i * 4];
        let c: u64 = b[i * 4 + 1];
        let d: u64 = b[i * 4 + 2];
        let e: u64 = b[i * 4 + 3];
        w[i] = (a << 24) | (c << 16) | (d << 8) | e;
    }
    for (16..64) |i| {
        let s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
        let s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & M;
    }
    var v: [8]u64 = undefined;
    for (0..8) |i| { v[i] = h[i]; }
    for (0..64) |i| {
        let s1 = rotr(v[4], 6) ^ rotr(v[4], 11) ^ rotr(v[4], 25);
        let ch = (v[4] & v[5]) ^ ((v[4] ^ M) & v[6]);
        let k: u64 = K[i];
        let t1 = (v[7] + s1 + ch + k + w[i]) & M;
        let s0 = rotr(v[0], 2) ^ rotr(v[0], 13) ^ rotr(v[0], 22);
        let maj = (v[0] & v[1]) ^ (v[0] & v[2]) ^ (v[1] & v[2]);
        let t2 = (s0 + maj) & M;
        v[7] = v[6];
        v[6] = v[5];
        v[5] = v[4];
        v[4] = (v[3] + t1) & M;
        v[3] = v[2];
        v[2] = v[1];
        v[1] = v[0];
        v[0] = (t1 + t2) & M;
    }
    for (0..8) |i| { h[i] = (h[i] + v[i]) & M; }
}

// The SHA-256 of the bytes, as 64 lowercase hex digits.
pub fn hex(data: []const u8) -> []const u8 {
    var h = [_]u64 { 0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19 };
    let whole = data.len / 64;
    for (0..whole) |i| { block(&h, data[i * 64..i * 64 + 64]); }
    // the rest, a 0x80 byte, zeroes, and the length in bits: one or two more blocks
    var tail: [128]u8 = undefined;
    for (0..128) |i| { tail[i] = 0; }
    let rest = data.len - whole * 64;
    for (0..rest) |i| { tail[i] = data[whole * 64 + i]; }
    tail[rest] = 0x80;
    let n: usize = if (rest < 56) 64 else 128;
    let bits = data.len as u64 * 8;
    for (0..8) |i| { tail[n - 1 - i] = ((bits >> (i as u64 * 8)) & 0xff) as u8; }
    block(&h, tail[0..64]);
    if (n == 128) { block(&h, tail[64..128]); }
    let digits = "0123456789abcdef";
    let out = alloc.make(u8, 64);
    for (0..8) |i| {
        for (0..8) |j| {
            out[i * 8 + j] = digits[((h[i] >> ((7 - j) as u64 * 4)) & 0xf) as usize];
        }
    }
    return out;
}
