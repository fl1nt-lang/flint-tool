// base.term - color for what the compiler prints: errors, help, hints.
//
// Color is used when the output is a terminal and NO_COLOR isn't set; --color=always|never
// overrides that. Without color every function here returns its text unchanged, so output that's
// piped or saved to a file has no escape codes in it.

import std.process;
import base.text;

extern fn isatty(fd: i32) -> i32;

pub enum When { Auto, Always, Never }

pub var when: When = .Auto;

pub let OUT: i32 = 1; // stdout
pub let ERR: i32 = 2; // stderr

// is text written to this file descriptor colored?
pub fn on(fd: i32) -> bool {
    if (when == .Always) { return true; }
    if (when == .Never) { return false; }
    if (process.getEnv("NO_COLOR")) |v| { if (v.len > 0) { return false; } }
    if (process.getEnv("TERM")) |t| { if (text.eq(t, "dumb")) { return false; } }
    return isatty(fd) != 0;
}

fn paint(fd: i32, code: []const u8, s: []const u8) -> []const u8 {
    if (!on(fd)) { return s; }
    return text.f("\x1b[{s}m{s}\x1b[0m", .{code, s});
}

pub fn bold(fd: i32, s: []const u8) -> []const u8 { return paint(fd, "1", s); }
pub fn red(fd: i32, s: []const u8) -> []const u8 { return paint(fd, "1;31", s); }
pub fn green(fd: i32, s: []const u8) -> []const u8 { return paint(fd, "1;32", s); }
pub fn cyan(fd: i32, s: []const u8) -> []const u8 { return paint(fd, "1;36", s); }
pub fn dim(fd: i32, s: []const u8) -> []const u8 { return paint(fd, "2", s); }

// a message's label on stderr: "error" in red, "note" and "hint" in cyan
pub fn label(kind: []const u8) -> []const u8 {
    return if (text.eq(kind, "error")) red(ERR, kind) else cyan(ERR, kind);
}
